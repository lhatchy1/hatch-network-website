{
  "rules": {
    "requests": {
      ".read": true,
      "$requestId": {
        ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid || auth.token.email != null)"
      }
    },
    "plexStats": {
      ".read": true,
      ".write": false
    },
    "upcoming": {
      ".read": true,
      ".write": false
    },
    "upcomingMovies": {
      ".read": true,
      ".write": false
    },
    "upcomingRequested": {
      ".read": true,
      "$key": {
        ".write": "auth != null && (!data.exists() || auth.token.email != null)",
        ".validate": "newData.hasChildren(['title', 'kind', 'requestedAt'])"
      }
    },
    "serverStatus": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null"
    }
  }
}
